  coutAchat            String?     @map("cout_achat") // CONFIRMED varchar in the real schema, not numeric — stored as free text
  dateAchat            DateTime?   @map("date_achat")
  dateMiseEnService    DateTime?   @map("date_mise_en_service")
  dateFinGarantie      DateTime?   @map("date_fin_garentie") // legacy column name itself is misspelled ("garentie")
