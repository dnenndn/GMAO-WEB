// ============================================================================
// Diagnostics module (Phase 15) — Ishikawa/AMDEC root-cause analysis
//
// Discovered via the real schema export — a genuinely sophisticated
// root-cause-analysis workflow tied to Work Orders, confirming what the
// Maintenance spec had flagged since Phase 1 as "not yet built" (Ishikawa/
// AMDEC diagnostics). Five per-OT tables plus reference-data catalogs:
//
//   OtDiagnosticM         — the root diagnostic entry: which failure mode
//                           was identified, and its classification (type_m)
//   OtDiagnosticSymptome  — symptoms observed for this OT
//   OtDiagnosticDetection — how the failure was detected (type_d)
//   OtDiagnosticDef       — confirmed root/contributing causes, chained
//                           via RelationAnomalie's cause hierarchy
//   OtDiagnosticOperation — diagnostic tests/operations actually performed,
//                           with start/end timestamps (a checklist-execution log)
//
// RelationAnomalie is a genuine discovery: ParametreAnomalie (failure
// modes) turns out to be a SELF-REFERENCING HIERARCHY (parent/child cause
// chains — classic Ishikawa fishbone branches), modeled via a separate
// join table rather than a parent-id column directly on the anomaly table.
// ============================================================================

/// Parent/child cause hierarchy between failure modes — an Ishikawa-style
/// fishbone branch structure.
model RelationAnomalie {
  id         Int              @id @default(autoincrement())
  idAnomalie Int              @map("id_anomalie")
  anomalie   ParametreAnomalie @relation("AnomalieChild", fields: [idAnomalie], references: [id])
  idParent   Int              @map("id_parent")
  parent     ParametreAnomalie @relation("AnomalieParent", fields: [idParent], references: [id])

  @@map("relation_anomalie")
}

/// Which symptoms are catalog-associated with which failure mode —
/// reference data, not tied to a specific Work Order.
model SymptomeDefaillance {
  id            Int               @id @default(autoincrement())
  idSymptome    Int               @map("id_symptome")
  symptome      Symptome          @relation(fields: [idSymptome], references: [id])
  idDefaillance Int               @map("id_defaillance")
  defaillance   ParametreAnomalie @relation(fields: [idDefaillance], references: [id])

  @@map("symptome_defaillance")
}

/// Catalog of diagnostic tests/operations available for a given failure
/// mode (e.g. "Check oil level" for "Oil leak").
model OperationDiagnostic {
  id            Int               @id @default(autoincrement())
  idDefaillance Int               @map("id_defaillance")
  defaillance   ParametreAnomalie @relation(fields: [idDefaillance], references: [id])
  code          String?
  designation   String
  deleted       Boolean           @default(false)

  otOperations OtDiagnosticOperation[]

  @@map("operation_diagnostic")
}

/// The root diagnostic entry for a Work Order — which failure mode was
/// identified, and `typeM`'s classification (exact value set unconfirmed).
model OtDiagnosticM {
  id            Int               @id @default(autoincrement())
  idOt          Int               @map("id_ot")
  ordreTravail  OrdreTravail      @relation(fields: [idOt], references: [id])
  idDefaillance Int               @map("id_defaillance")
  defaillance   ParametreAnomalie @relation(fields: [idDefaillance], references: [id])
  typeM         String            @map("type_m")

  @@map("ot_diagnostic_m")
}

/// Additional confirmed root/contributing causes for a Work Order's
/// diagnosis, beyond the primary failure mode in OtDiagnosticM — chained
/// via RelationAnomalie's cause hierarchy.
model OtDiagnosticDef {
  id            Int               @id @default(autoincrement())
  idOt          Int               @map("id_ot")
  ordreTravail  OrdreTravail      @relation(fields: [idOt], references: [id])
  idDefaillance Int               @map("id_defaillance")
  defaillance   ParametreAnomalie @relation(fields: [idDefaillance], references: [id])

  @@map("ot_diagnostic_def")
}

/// How the failure was detected for this Work Order. `typeD`'s exact
/// value set is unconfirmed — no matching reference/catalog table was
/// found in the real schema for it.
model OtDiagnosticDetection {
  id            Int               @id @default(autoincrement())
  idOt          Int               @map("id_ot")
  ordreTravail  OrdreTravail      @relation(fields: [idOt], references: [id])
  idDefaillance Int               @map("id_defaillance")
  defaillance   ParametreAnomalie @relation(fields: [idDefaillance], references: [id])
  typeD         Int               @map("type_d")

  @@map("ot_diagnostic_detection")
}

/// Symptoms actually observed for this Work Order (as opposed to
/// SymptomeDefaillance, which is the general catalog association).
model OtDiagnosticSymptome {
  id            Int               @id @default(autoincrement())
  idOt          Int               @map("id_ot")
  ordreTravail  OrdreTravail      @relation(fields: [idOt], references: [id])
  idSymptome    Int               @map("id_symptome")
  symptome      Symptome          @relation(fields: [idSymptome], references: [id])
  idDefaillance Int               @map("id_defaillance")
  defaillance   ParametreAnomalie @relation(fields: [idDefaillance], references: [id])

  @@map("ot_diagnostic_symptome")
}

/// Diagnostic tests/operations actually performed for this Work Order,
/// with timing — a checklist-execution log against the OperationDiagnostic
/// catalog.
model OtDiagnosticOperation {
  id          Int                 @id @default(autoincrement())
  idOt        Int                 @map("id_ot")
  ordreTravail OrdreTravail       @relation(fields: [idOt], references: [id])
  idOperation Int                 @map("id_operation")
  operation   OperationDiagnostic @relation(fields: [idOperation], references: [id])
  debut       DateTime
  fin         DateTime

  @@map("ot_diagnostic_operation")
}

// ============================================================================
// Invoicing (Phase 16) — Procurement & Subcontracting
//
// Discovered via the real schema export. `bon_livraison` is a genuine
// formal delivery-note step, distinct from Reception — it wraps an
// existing Reception (real FK: id_reception) rather than duplicating its
// line items (no bon_livraison_article table exists; a guess to that
// effect was checked directly against the schema export and disproven).
// Invoices (Facture) then reference one or more delivery notes via the
// junction FactureLivraison. Subcontracting has an exactly parallel pair
// (DsFacture/DsFactureLivraison) referencing the already-existing
// DsBonLivraison instead.
// ============================================================================

/// CORRECTED: an earlier pass (Phase 16) assumed a BonLivraison had no
/// line items of its own and simply displayed its linked Reception's
/// items instead. That was wrong — `creer_bl.cs` confirms a real,
/// separate `livraison_article` insert with its own qt/prixHt/remise,
/// independent of `reception_article`. Kept `idReception` (still a real
/// column, the delivery note does reference the underlying goods
/// receipt) but added the real line-items relation below.
model BonLivraison {
  id             Int        @id @default(autoincrement())
  dateLivraison  DateTime   @map("date_livraison")
  heureLivraison String?    @map("heure_livraison")
  livraisonPar   String?    @map("livraison_par")
  idReception    Int        @map("id_reception")
  reception      Reception  @relation(fields: [idReception], references: [id])
  statut         String     @default("En cours")
  // CORRECTED — found via a direct SQL Server check against the real
  // legacy source: this column is genuinely SqlDbType.Int in the C#
  // source (bl_non_facture.cs/creer_bl.cs), not a string. Confirmed
  // real distribution: 0 = "Non Facturé" (32 rows), 1 = "Facturé"
  // (9737 rows). The "En cours" default here was never real — it never
  // appears in the actual migrated data. See
  // migration/fixups/misc-statut-recovery.ts.
  dateReel       DateTime?  @map("date_reel")
  blFournisseur  String?    @map("bl_fournisseur") // the supplier's own delivery-note reference

  factures FactureLivraison[]
  lignes   LivraisonArticle[]

  @@map("bon_livraison")
}

model LivraisonArticle {
  id             Int          @id @default(autoincrement())
  idLivraison    Int          @map("id_livraison")
  livraison      BonLivraison @relation(fields: [idLivraison], references: [id])
  idArticle      Int          @map("id_article")
  article        Article      @relation(fields: [idArticle], references: [id])
  qt             Decimal
  prixHt         Decimal      @map("prix_ht")
  remise         Decimal
  investissement Boolean?     // capital-investment flag — source is a nullable int, standard 0/1 pattern

  @@map("livraison_article")
}

// ============================================================================
// Remaining small tables (Phase 26)
