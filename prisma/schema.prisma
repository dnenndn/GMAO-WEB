model TableauFournisseurFichier {
  id            Int         @id @default(autoincrement())
  idFournisseur Int         @map("id_fournisseur")
  fournisseur   Fournisseur @relation(fields: [idFournisseur], references: [id])
  adresse       String

  @@map("tableau_fournisseur_fichier")
}

// ============================================================================
// Article reference-data / profile (Phase 23)
//
// Discovered via the real schema export — parallel in shape to the
// Fournisseur reference-data family (Phase 22): 3 tables link Article to
// a fixed-category parametre_* lookup (classification/emplacement/
// stockage), and 2 link Article directly to another real entity
// (Equipement — which equipment this part fits/is used on; Fournisseur —
// which supplier(s) carry it, complementing the DOP/Devis price-survey
// workflow rather than duplicating it).
//
// `ParametreImage` is a genuine outlier despite the similar name — a
// single-row config table (no `id_article` or any FK at all) holding 3
// fixed site photos (parc/atelier/usine). Modeled as a singleton;
// deliberately no UI built around it yet since no confirmed usage
// context (which screen displays these?) was found in the decompiled
// source, unlike everything else in this migration.
// ============================================================================

model ParametreClassificationArticle {
  id                 Int      @id @default(autoincrement())
  codeClassification String?  @map("code_classification")
  designation        String
  deleted            Boolean  @default(false)

  articles TableauArticleClassification[]

  @@map("parametre_classification_article")
}

model TableauArticleClassification {
  id                Int                            @id @default(autoincrement())
  idArticle         Int                             @map("id_article")
  article           Article                         @relation(fields: [idArticle], references: [id])
  idClassification  Int                             @map("id_classification")
  classification    ParametreClassificationArticle  @relation(fields: [idClassification], references: [id])

  @@map("tableau_article_classification")
}

model ParametreEmplacementArticle {
  id              Int      @id @default(autoincrement())
  codeEmplacement String?  @map("code_emplacement")
  designation     String
  deleted         Boolean  @default(false)

  articles TableauArticleEmplacement[]

  @@map("parametre_emplacement_article")
}

model TableauArticleEmplacement {
  id            Int                          @id @default(autoincrement())
  idArticle     Int                           @map("id_article")
  article       Article                       @relation(fields: [idArticle], references: [id])
  idEmplacement Int                           @map("id_emplacement")
  emplacement   ParametreEmplacementArticle   @relation(fields: [idEmplacement], references: [id])

  @@map("tableau_article_emplacement")
}

model ParametreStockageArticle {
  id           Int      @id @default(autoincrement())
  codeStockage String?  @map("code_stockage")
  designation  String
  deleted      Boolean  @default(false)

  articles TableauArticleStockage[]

  @@map("parametre_stockage_article")
}

model TableauArticleStockage {
  id         Int                        @id @default(autoincrement())
  idArticle  Int                         @map("id_article")
  article    Article                     @relation(fields: [idArticle], references: [id])
  idStockage Int                         @map("id_stockage")
  stockage   ParametreStockageArticle    @relation(fields: [idStockage], references: [id])

  @@map("tableau_article_stockage")
}

/// Which Equipement(s) this article/part is used on or compatible with —
/// a direct link, no lookup table involved.
model TableauArticleEquipement {
  id           Int        @id @default(autoincrement())
  idArticle    Int        @map("id_article")
  article      Article    @relation(fields: [idArticle], references: [id])
  idEquipement Int        @map("id_equipement")
  equipement   Equipement @relation(fields: [idEquipement], references: [id])

  @@map("tableau_article_equipement")
}

/// Which Fournisseur(s) carry this article — complements, doesn't
/// duplicate, the DOP/Devis price-survey workflow (Phase 11): this is a
/// standing "usual suppliers" list, not a specific price quote.
model TableauArticleFournisseur {
  id            Int         @id @default(autoincrement())
  idArticle     Int         @map("id_article")
  article       Article     @relation(fields: [idArticle], references: [id])
  idFournisseur Int         @map("id_fournisseur")
  fournisseur   Fournisseur @relation(fields: [idFournisseur], references: [id])

  // 11,000+ real rows; both directions genuinely queried — "which
  // suppliers carry this article" and "which articles does this
  // supplier carry".
  @@index([idArticle])
  @@index([idFournisseur])
  @@map("tableau_article_fournisseur")
}

/// Singleton config — 3 fixed site photos, no per-row key at all in the
/// source. No confirmed UI destination; modeled but not surfaced yet.
model ParametreImage {
  id           Int     @id @default(autoincrement())
  photoParc    Bytes?  @map("photo_parc")
  photoAtelier Bytes?  @map("photo_atelier")
  photoUsine   Bytes?  @map("photo_usine")

  @@map("parametre_image")
}

// ============================================================================
// Notification system (Phase 24)
//
// Discovered via the real schema export. Two closely related tables:
// `Notification` is the event (with a polymorphic idN+type reference to
// whatever triggered it — no real FK, matching the zero-FK-constraint
// pattern everywhere else in this schema; the exact set of `type` values
// and which table each maps to isn't confirmed), `NotificationAlerte` is
// a follow-up/escalation alert tied back to a specific Notification.
// `idUtilisateur` on both is modeled as a real FK to Utilisateur.id
// (not the login-string pattern used for `createur`-style audit fields
// elsewhere) since this represents genuine "who should see this"
// targeting, not an audit trail of who performed an action.
// ============================================================================

model Notification {
  id            Int          @id @default(autoincrement())
  idN           Int?         @map("id_n") // polymorphic ref to the source entity — target table determined by `type`; partially confirmed via a C# source cross-check ("Création Commande", "OT Nbr Panne", "Signature Commande", "Variation Commande" all appear as real values), full set still not exhaustively confirmed
  type          String?
  idUtilisateur Int?         @map("id_utilisateur")
  utilisateur   Utilisateur? @relation(fields: [idUtilisateur], references: [id])
  description   String?
  vue           Boolean      @default(false)
  dateCreation  DateTime?    @map("date_creation")

  alertes NotificationAlerte[]

  // Real performance issue found: this exact (idUtilisateur, vue) filter
  // runs on the sidebar's unread-count badge — which means on literally
  // every single page load across the entire app. With 1.5M+ real rows
  // and no index, Postgres has no choice but to sequentially scan the
  // whole table on every click. This single missing index was very
  // likely the single largest cause of app-wide sluggishness once real
  // data volume existed — invisible against a handful of seed rows,
  // severe against real production data.
  @@index([idUtilisateur, vue])
  @@map("notification")
}

model NotificationAlerte {
  id            Int          @id @default(autoincrement())
  idNot         Int          @map("id_not")
  notification  Notification @relation(fields: [idNot], references: [id])
  type          String
  idUtilisateur Int?         @map("id_utilisateur")
  utilisateur   Utilisateur? @relation(fields: [idUtilisateur], references: [id])
  description   String
  vue           Boolean      @default(false)
  dateCreation  DateTime     @map("date_creation")

  // Same universal-page-load query pattern as Notification above —
  // indexed for the same reason.
  @@index([idUtilisateur, vue])
  @@map("notification_alerte")
}

// ============================================================================
// Activité scoping & operations checklist (Phase 25)
//
// Discovered via the real schema export. Extends the existing
// ActiviteSousTraitance (Subcontracting) with which Famille/SousFamille
// of articles an activity applies to, plus a repeatable text checklist
// of operations that activity involves.
// ============================================================================

model ActiviteFamille {
  id          Int                 @id @default(autoincrement())
  idActivite  Int                 @map("id_activite")
  activite    ActiviteSousTraitance @relation(fields: [idActivite], references: [id])
  idFamille   Int                 @map("id_famille")
  famille     Famille             @relation(fields: [idFamille], references: [id])

  @@map("activite_famille")
}

model ActiviteOperation {
  id         Int                   @id @default(autoincrement())
  idActivite Int                   @map("id_activite")
  activite   ActiviteSousTraitance @relation(fields: [idActivite], references: [id])
  operation  String

  @@map("activite_operation")
}

model ActiviteSousFamille {
  id            Int                   @id @default(autoincrement())
  idActivite    Int                   @map("id_activite")
  activite      ActiviteSousTraitance @relation(fields: [idActivite], references: [id])
  idSousFamille Int                   @map("id_sous_famille")
  sousFamille   SousFamille           @relation(fields: [idSousFamille], references: [id])

  @@map("activite_sous_famille")
}

// ============================================================================
// OT/Equipement odds and ends (Phase 26)
//
// Discovered via the real schema export. `parametre_centre_charge` fills
// a real gap: `OtCentreCharge.idCentreCharge` (migrated tier 18) was a
// bare unrelated int with no lookup table behind it at the time —
// wired up to a real relation now that this table exists, matching the
// pattern already established for EquipementCompteur (tier 7).
//
// `equipement_compteur_historique` and `equipement_compteur_nv` are
// parallel but distinct: the former is routine measurement history
// (regular counter readings over time), the latter tracks
// reset/recalibration events specifically (a counter manually set to a
// new value, "nv" = nouvelle valeur) — not the same log, kept as two
// separate tables matching the source.
//
// `compteur_liaison` defines which counter governs a given
// organe+intervention-type combination — likely consulted by the
// counter-based preventive-maintenance trigger logic (PrevCompteur,
// tier 11) to resolve which counter applies, though no direct code
// reference confirming that specific consumer was found.
// ============================================================================

model ParametreCauseRealisation {
  id          Int    @id @default(autoincrement())
  code        String?
  designation String

  ots OtCauseRealisation[]

  @@map("parametre_cause_realisation")
}

model OtCauseRealisation {
  id       Int                       @id @default(autoincrement())
  idOt     Int                       @map("id_ot")
  ordreTravail OrdreTravail          @relation(fields: [idOt], references: [id])
  idCause  Int                       @map("id_cause")
  cause    ParametreCauseRealisation @relation(fields: [idCause], references: [id])

  @@map("ot_cause_realisation")
}

model ParametreCentreCharge {
  id          Int      @id @default(autoincrement())
  code        String?
  designation String
  budget      Decimal?

  ots OtCentreCharge[]
  gammes GammeCentreCharge[]

  @@map("parametre_centre_charge")
}

model EquipementCompteurHistorique {
  id         Int                @id @default(autoincrement())
  idCompteur Int                @map("id_compteur")
  compteur   EquipementCompteur @relation(fields: [idCompteur], references: [id])
  valeur     Decimal
  dateMesure DateTime           @map("date_mesure")

  @@map("equipement_compteur_historique")
}

/// Reset/recalibration events — a counter manually set to a new value
/// ("nv" = nouvelle valeur), distinct from routine measurement history.
model EquipementCompteurNv {
  id         Int                @id @default(autoincrement())
  idCompteur Int                @map("id_compteur")
  compteur   EquipementCompteur @relation(fields: [idCompteur], references: [id])
  valeur     Decimal
  dateNv     DateTime           @map("date_nv")

  @@map("equipement_compteur_nv")
}

/// Which counter governs a given organe+intervention-type combination.
model CompteurLiaison {
  id              Int                  @id @default(autoincrement())
  idOrgane        Int                  @map("id_organe")
  organe          Equipement           @relation(fields: [idOrgane], references: [id])
  idCompteur      Int                  @map("id_compteur")
  compteur        EquipementCompteur   @relation(fields: [idCompteur], references: [id])
  idIntervention  Int                  @map("id_intervention")
  intervention    ParametreIntervention @relation(fields: [idIntervention], references: [id])

  @@map("compteur_liaison")
}

// ============================================================================
// Production — remaining pieces (Phase 26)
//
// Discovered via the real schema export. `id_saisie` on ProdMesure
// follows the same naming convention already confirmed on
// ProdRapportPrepAS (maps to ProdSaisie.id despite the source column
// being literally named id_qualite there) — applied consistently here.
// `id_mesure` has no identifiable target table anywhere in this schema;
// modeled as a plain unconfirmed int rather than guessing a relation.
// ============================================================================

/// Reference/whitelist table — which measurement type applies to which
/// ProdSaisie + ProdEquipement combination. Not a report entry (no
/// id_rapport) — a config table, unlike ProdMesureRapport which stores
/// actual measured values.
model ProdMesure {
  id        Int            @id @default(autoincrement())
  idMesure  Int            @map("id_mesure") // no identifiable target table — unconfirmed
  idSaisie  Int            @map("id_saisie")
  saisie    ProdSaisie     @relation(fields: [idSaisie], references: [id])
  idUnite   Int            @map("id_unite")
  unite     Equipement @relation(fields: [idUnite], references: [id])

  @@map("prod_mesure")
}

/// A team-lead assignment per report+unit — distinct from, not a
/// duplicate of, ProdRapportCfFabrication/ProdRapportCfEmballage (both
/// confirmed real, Fabrication/Emballage-specific); this one carries no
/// line-specific qualifier in its name, so modeled as its own table
/// rather than assumed identical in scope to either.
model ProdRapportChefEquipe {
  id            Int                @id @default(autoincrement())
  idRapport     Int                @map("id_rapport")
  rapport       ProdRapportGeneral @relation(fields: [idRapport], references: [id])
  idUnite       Int                @map("id_unite")
  unite         Equipement     @relation(fields: [idUnite], references: [id])
  idChefEquipe  Int                @map("id_chef_equipe")
  chefEquipe    Intervenant        @relation(fields: [idChefEquipe], references: [id])

  @@map("prod_rapport_chef_equipe")
}

/// Which product ran on which unit during which hour of a shift — no
/// quantity/value column (unlike ProdRapportHoraireFabrication's h1-h8
/// measured values), just a presence/tracking record.
model ProdRapportHeure {
  id        Int            @id @default(autoincrement())
  idRapport Int            @map("id_rapport")
  rapport   ProdRapportGeneral @relation(fields: [idRapport], references: [id])
  idUnite   Int            @map("id_unite")
  unite     Equipement @relation(fields: [idUnite], references: [id])
  heure     Int
  idProduit Int            @map("id_produit")

  @@map("prod_rapport_heure")
}
