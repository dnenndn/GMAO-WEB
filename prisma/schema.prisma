// ============================================================================
// Article characteristics & units (Phase 12) — dynamic custom-fields system
//
// Discovered via the real schema export. Confirmed a genuine dynamic
// form-builder scoped per SousFamille: `ajouter_caractéristique.cs`'s field-
// type dropdown ("TextBox" | "Select Unique" | "Select Multiple" |
// "CheckBox" | "Radio Button") and `modifier_caracteristique_textbox.cs`'s
// value-type dropdown ("Chaîne de caractères" | "Entier" | "Réel") were
// both confirmed directly in the decompiled source, not guessed. This lets
// each product sub-family define its own custom fields (e.g. "Roulements"
// might have a "Diamètre intérieur" numeric field; a different sub-family
// has entirely different fields) — Article itself stays generic, with
// per-sous-famille characteristics captured in TableauArticleCaracteristique.
// ============================================================================

model Caracteristique {
  id               Int         @id @default(autoincrement())
  idSousFamille    Int         @map("id_sous_famille")
  sousFamille      SousFamille @relation(fields: [idSousFamille], references: [id])
  nom              String
  type             String      // "TextBox" | "Select Unique" | "Select Multiple" | "CheckBox" | "Radio Button" — confirmed values
  champObligatoire Boolean     @default(false) @map("champ_obligatoire")
  deleted          Boolean     @default(false)

  options   CaracteristiqueOption[]
  textboxes CaracteristiqueTextbox[]
  valeurs   TableauArticleCaracteristique[]

  @@map("caracteristique")
}

/// Options for "Select Unique"/"Select Multiple"/"Radio Button" type
/// characteristics.
model CaracteristiqueOption {
  id                Int             @id @default(autoincrement())
  idCaracteristique Int             @map("id_caracteristique")
  caracteristique   Caracteristique @relation(fields: [idCaracteristique], references: [id])
  valeurOption      String          @map("valeur_option")
  defaut            Boolean         @default(false)

  @@map("caracteristique_option")
}

/// Extra config for "TextBox" type characteristics — confirmed value-type
/// dropdown from modifier_caracteristique_textbox.cs.
model CaracteristiqueTextbox {
  id                Int             @id @default(autoincrement())
  idCaracteristique Int             @map("id_caracteristique")
  caracteristique   Caracteristique @relation(fields: [idCaracteristique], references: [id])
  type              String?         // "Chaîne de caractères" | "Entier" | "Réel" — confirmed values
  valeurDefaut      String?         @map("valeur_defaut")

  @@map("caracteristique_textbox")
}

/// The actual recorded value of a characteristic for a specific article.
model TableauArticleCaracteristique {
  id                Int             @id @default(autoincrement())
  idArticle         Int             @map("id_article")
  article           Article         @relation(fields: [idArticle], references: [id])
  idCaracteristique Int             @map("id_caracteristique")
  caracteristique   Caracteristique @relation(fields: [idCaracteristique], references: [id])
  valeur            String?

  @@map("tableau_article_caracteristique")
}

model ParametreUniteArticle {
  id          Int      @id @default(autoincrement())
  codeUnite   String   @map("code_unite")
  designation String
  deleted     Boolean  @default(false)

  articles TableauArticleUnite[]
  prodFourConsommations ProdFourConsommationElectrique[]

  @@map("parametre_unite_article")
}

/// Article <-> unit-of-measure link. Modeled as a junction table matching
/// the real schema shape, even though in practice it's likely one row per
/// article (purchase/stock unit) rather than a true many-to-many.
model TableauArticleUnite {
  id        Int                   @id @default(autoincrement())
  idArticle Int                   @map("id_article")
  article   Article               @relation(fields: [idArticle], references: [id])
