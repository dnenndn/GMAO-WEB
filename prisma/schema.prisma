// ============================================================================
// Automatic reorder planning (Phase 18) — Inventory
//
// Discovered via the real schema export. Two distinct recurring reorder
// methods, both never modeled before this pass: "Réapprovisionnement"
// (fixed order quantity `qt` each cycle) and "Recomplétement" (no fixed
// quantity — replenishes up to a target level, presumably Article's
// existing stockMaxi, though no direct FK confirms this). Both share the
// same recurrence shape already seen in PrevSystematique
// (dateDebut/reccurence/periode/dateLimite/arr), and each has a parallel
// "_ech" (échéance — due-date occurrence) table logging when a cycle
// actually came due, mirroring how OtReinitCompteur tracks preventive-
// maintenance triggers.
// ============================================================================

model AcReapprovisionnement {
  id          Int      @id @default(autoincrement())
  idArticle   Int      @map("id_article")
  article     Article  @relation("ArticleReappro", fields: [idArticle], references: [id])
  qt          Decimal  // fixed reorder quantity each cycle
  delai       Int      // lead time
  dateDebut   DateTime @map("date_debut")
  heureDebut  String?  @map("heure_debut")
  reccurence  Int      // cycle count, same pattern as PrevSystematique.frequence
  dateLimite  DateTime? @map("date_limite")
  periode     String?  // "Jour" | "Semaine" | "Mois" | "Année" — same pattern as PrevSystematique.periode
  arr         Boolean  @default(false)

  echeances AcReapprovisionnementEch[]

  @@map("ac_reapprovisionnement")
}

model AcReapprovisionnementEch {
  id        Int                    @id @default(autoincrement())
  idRep     Int                    @map("id_rep")
  plan      AcReapprovisionnement  @relation(fields: [idRep], references: [id])
  dateEch   DateTime               @map("date_ech")
  heureEch  String?                @map("heure_ech")
  deleted   Boolean                @default(false)

  @@map("ac_reapprovisionnement_ech")
}

/// Same shape as AcReapprovisionnement but with no fixed `qt` — replenishes
/// to a target level rather than a fixed order quantity each cycle.
model AcRecompletement {
  id          Int      @id @default(autoincrement())
  idArticle   Int      @map("id_article")
  article     Article  @relation("ArticleRecomplet", fields: [idArticle], references: [id])
  delai       Int
  dateDebut   DateTime @map("date_debut")
  heureDebut  String?  @map("heure_debut")
  reccurence  Int
  dateLimite  DateTime @map("date_limite")
  periode     String?
  arr         Boolean  @default(false)

  echeances AcRecompletementEch[]

  @@map("ac_recompletement")
}

model AcRecompletementEch {
  id        Int              @id @default(autoincrement())
  idRep     Int              @map("id_rep")
  plan      AcRecompletement @relation(fields: [idRep], references: [id])
  dateEch   DateTime         @map("date_ech")
  heureEch  String?          @map("heure_ech")
  deleted   Boolean          @default(false)

  @@map("ac_recompletement_ech")
}

// ============================================================================
// Fleet extras (Phase 19) — Bons de carburant, Voyages
//
// Discovered via the real schema export, both confirmed directly against
// the decompiled source (saisie_de_bons_carburants.cs, saisie_voyage.cs).
// BonDeCarburant is a fuel VOUCHER/authorization (has a driver + a `nom`
// label, no odometer reading) — distinct from EnginSortieCarburant
// (Phase 6, confirmed real fuel dispensing event with an odometer
// reading, no driver column). Voyage is a straightforward trip log.
// ============================================================================

model BonDeCarburant {
  id               Int            @id @default(autoincrement())
  nom              String
  quantite         Decimal
  prixU            Decimal        @map("prix_u")
  prixTtc          Decimal        @map("prix_ttc")
  date             DateTime
  idEngin          Int            @map("id_engin")
  engin            Engin          @relation(fields: [idEngin], references: [id])
  idChauffeur      Int            @map("id_chauffeur")
  chauffeur        Chauffeur      @relation(fields: [idChauffeur], references: [id])
  idTypeCarburant  Int            @map("id_type_carburant")
  typeCarburant    TypeCarburant  @relation(fields: [idTypeCarburant], references: [id])
  deleted          Boolean        @default(false)

  @@map("bon_de_carburant")
}

model Voyage {
  id          Int       @id @default(autoincrement())
  depart      String
  arrive      String
  distance    Decimal
  date        DateTime
  heureDep    String?   @map("heure_dep")
  heureArr    String?   @map("heure_arr")
