  @@map("parametre_livraison_fournisseur")
}

model TableauFournisseurLivraison {
  id            Int                            @id @default(autoincrement())
  idFournisseur Int                             @map("id_fournisseur")
  fournisseur   Fournisseur                     @relation(fields: [idFournisseur], references: [id])
  idLivraison   Int                             @map("id_livraison")
  livraison     ParametreLivraisonFournisseur   @relation(fields: [idLivraison], references: [id])

