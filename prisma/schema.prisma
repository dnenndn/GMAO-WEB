// ============================================================================
// Procurement quote step (Phase 11) — "Devis" via "DOP"
//
// Discovered via the real schema export (docs/12-schema-validation-
// findings.md) — this was NOT built in the original Procurement phase,
// which went straight DemandeAchat -> Commande. The real app has a
// separate price-survey/RFQ step in between: a DOP (Demande d'Ouverture
// de Prix — "request to open pricing") invites multiple suppliers to
// quote on a set of articles; DopFini is the resulting comparison matrix
// (one row per article x supplier, with their quoted price/availability);
// a Devis formalizes the chosen result for one supplier.
//
// IMPORTANT: like everywhere else in this database, there are ZERO
// foreign key constraints — Dop/Devis are NOT linked to DemandeAchat or
// Commande by any declared relation. This appears to be a standalone
// price-comparison tool: staff run a DOP to survey pricing, then
// separately create the DA/Commande informed by what they found, without
// a hard database link back. Modeled accordingly — no relation is forced
// between this and DemandeAchat/Commande.
// ============================================================================

model Dop {
  id       Int      @id @default(autoincrement())
  dateDop  DateTime @map("date_dop")
  heureDop String?  @map("heure_dop")
  createur String?
  statut   String   @default("En cours")
  // CORRECTED — confirmed via tableau_comparatif.cs/liste_dop.cs and a
  // direct SQL Server check: 0 = "En attente" (1 row), 1 = "Confirmée"
  // (a supplier chosen via the comparison table, 132 rows), 5 =
  // "Annulée" (23 rows) — the same 5=cancelled convention confirmed
  // elsewhere in this schema. See
  // migration/fixups/misc-statut-recovery.ts.

  articles     DopArticle[]
  fournisseurs DopFournisseur[]
  resultats    DopFini[]
  devis        Devis[]

  @@map("dop")
}

model DopArticle {
  id        Int     @id @default(autoincrement())
  idDop     Int     @map("id_dop")
  dop       Dop     @relation(fields: [idDop], references: [id])
  idArticle Int     @map("id_article")
  article   Article @relation(fields: [idArticle], references: [id])
  qt        Decimal

  @@map("dop_article")
}

model DopFournisseur {
  id            Int         @id @default(autoincrement())
  idDop         Int         @map("id_dop")
  dop           Dop         @relation(fields: [idDop], references: [id])
  idFournisseur Int         @map("id_fournisseur")
  fournisseur   Fournisseur @relation(fields: [idFournisseur], references: [id])

  @@map("dop_fournisseur")
}

/// The price-comparison matrix: one row per (article, supplier) pair
/// within a DOP, recording that supplier's quoted price/discount/
/// available quantity for that article. `fini` flags a row as settled/
/// decided (exact semantics not confirmed — best-effort boolean mapping).
model DopFini {
  id            Int          @id @default(autoincrement())
  idDop         Int          @map("id_dop")
  dop           Dop          @relation(fields: [idDop], references: [id])
  idArticle     Int          @map("id_article")
  article       Article      @relation(fields: [idArticle], references: [id])
  idFournisseur Int          @map("id_fournisseur")
  fournisseur   Fournisseur  @relation(fields: [idFournisseur], references: [id])
  prixHt        Decimal      @map("prix_ht")
  remise        Decimal
  qtDisponible  Decimal?     @map("qt_disponible")
  fini          Boolean      @default(false)

  @@map("dop_fini")
}

/// The formalized quote for a chosen supplier, referencing the DOP that
/// produced it (grouping only — no FK constraint, same as everywhere
/// else in this schema).
model Devis {
  id         Int      @id @default(autoincrement())
  dateDevis  DateTime @map("date_devis")
  heureDevis String?  @map("heure_devis")
  createur   String?
  idDop      Int      @map("id_dop")
  dop        Dop?     @relation(fields: [idDop], references: [id])
  statut     String   @default("En cours")
  // CORRECTED — same situation as DsDevis above: confirmed
  // integer-coded via a direct SQL Server check, only 0 currently in
  // real data (244 rows). Labeled "En attente" as the consistent
  // default state used everywhere else in this app. See
  // migration/fixups/misc-statut-recovery.ts.
  livr       Boolean  @default(false) // meaning not fully confirmed — see DsDevis.livr note

  lignes       DevisArticle[]
  fournisseurs DevisFournisseur[]
  fichiers     DevisFichier[]

  @@map("devis")
}

model DevisArticle {
  id           Int     @id @default(autoincrement())
  idDevis      Int     @map("id_devis")
  devis        Devis   @relation(fields: [idDevis], references: [id])
  idArticle    Int     @map("id_article")
  article      Article @relation(fields: [idArticle], references: [id])
  qtDisponible Decimal @map("qt_disponible")
  prixHt       Decimal @map("prix_ht")
  remise       Decimal

  @@map("devis_article")
}

model DevisFournisseur {
  id            Int         @id @default(autoincrement())
  idDevis       Int         @map("id_devis")
  devis         Devis       @relation(fields: [idDevis], references: [id])
  idFournisseur Int         @map("id_fournisseur")
  fournisseur   Fournisseur @relation(fields: [idFournisseur], references: [id])

  @@map("devis_fournisseur")
}

model DevisFichier {
  id      Int    @id @default(autoincrement())
  idDevis Int    @map("id_devis")
  devis   Devis  @relation(fields: [idDevis], references: [id])
  adresse String

  @@map("devis_fichier")
}

model AtelierCommentaire {
  id         Int          @id @default(autoincrement())
  idAtelier  Int          @map("id_atelier")
  job        AtelierCreer @relation(fields: [idAtelier], references: [id])
  texte      String
  auteur     String?
  date       DateTime     @default(now())

  @@map("atelier_commentaire")
}

model AtelierFichierAttachment {
  id        Int          @id @default(autoincrement())
  idAtelier Int          @map("id_atelier")
  job       AtelierCreer @relation(fields: [idAtelier], references: [id])
  adresse   String?

  @@map("atelier_fichier")
