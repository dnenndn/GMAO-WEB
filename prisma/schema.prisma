  idChauffeur Int       @map("id_chauffeur")
  chauffeur   Chauffeur @relation(fields: [idChauffeur], references: [id])
  deleted     Boolean   @default(false)

  @@map("voyage")
}

/// Confirmed real table, but with only `id_carburant` + `deleted` — no
/// `id_engin`/`id_parc` column at all despite the name. Likely a simple
/// active/inactive toggle for which fuel types apply to the fleet, mostly
/// redundant with TypeCarburant.deleted. Low confidence on its actual
/// purpose; modeled minimally, no UI built around it.
model EnginParcLiaisonCarburant {
  id            Int           @id @default(autoincrement())
  idCarburant   Int           @map("id_carburant")
  typeCarburant TypeCarburant @relation(fields: [idCarburant], references: [id])
  deleted       Boolean       @default(false)

  @@map("engin_parc_liaison_carburant")
}

// ============================================================================
// Order & article modification history (Phase 20) — Procurement/Inventory
//
// Discovered via the real schema export. Two distinct audit-log
// mechanisms: an edit to a purchase-order line (header +
// per-line snapshot, confirmed real, distinct from anything already
// modeled), and a separate, simpler log of Article pricing/stock field
// changes (date-only, no user column — likely written passively whenever
// those fields are edited, no direct evidence of who made the change).
// ============================================================================

/// Header for one edit event on a Commande — "who changed this order, and
/// when". The actual before/after line values live in
/// CommandeModifierArticle below.
model CommandeModificationBase {
  id                 Int      @id @default(autoincrement())
  idCommande         Int      @map("id_commande")
  commande           Commande @relation(fields: [idCommande], references: [id])
  modifierPar        String?  @map("modifier_par")
  dateModification   DateTime @map("date_modification")
  heureModification  String?  @map("heure_modification")

  lignes CommandeModifierArticle[]

  @@map("commande_modification_base")
}

/// Snapshot of one order line's qt/prixHt/remise at the time of a given
/// modification event.
model CommandeModifierArticle {
  id             Int                      @id @default(autoincrement())
  idModification Int                      @map("id_modification")
  modification   CommandeModificationBase @relation(fields: [idModification], references: [id])
  idArticle      Int                      @map("id_article")
  article        Article                  @relation(fields: [idArticle], references: [id])
  qt             Decimal
  prixHt         Decimal                  @map("prix_ht")
  remise         Decimal

  @@map("commande_modifier_article")
}

/// Passive change log for Article pricing/stock fields — no user column,
/// date only. Written whenever these fields are edited.
model ModificationArticle {
  id               Int       @id @default(autoincrement())
  idArticle        Int       @map("id_article")
  article          Article   @relation(fields: [idArticle], references: [id])
  tva              Decimal?
  prixHt           Decimal?  @map("prix_ht")
  stockNeuf        Decimal?  @map("stock_neuf")
  stockUse         Decimal?  @map("stock_use")
  stockRebute      Decimal?  @map("stock_rebute")
  dateModification DateTime  @map("date_modification")

  @@map("modification_article")
}

// ============================================================================
// Subcontracting raw-material provisioning & custom items (Phase 21)
//
// Discovered via the real schema export. Corrects an earlier assumption
// from the Sous-Traitance module (Phase 8): `id_t`/`source` on
// DsDevisArticle/DsCommandeArticle was modeled as possibly polymorphic,
// pointing either at Article directly or at a separate "custom items"
// catalog (guessed to be ds_nv_article). The real schema shows
// ds_nv_article ALSO has a real id_article FK — it's not an alternative
// catalog, it's its own request entity (a "new/custom" fabrication
// request against a base article, with its own quantity/activité/
// description), which `id_t` may reference when `source` indicates
// "Nv" rather than referencing Article directly. ds_mp is simpler: raw
// material the company sends TO a subcontractor for a given request.
//
// `id_demande` on both tables has no confirmed target (no FK constraints
// exist anywhere in this 215-table database — see docs/12-schema-
// validation-findings.md §"zero FK constraints"). It's plausibly a loose
// grouping reference similar to id_ds elsewhere, but that's a guess —
// modeled as a plain unconstrained integer.
// ============================================================================

/// Raw material ("Matière Première") the company provides to a
/// subcontractor for a given request.
model DsMp {
  id        Int     @id @default(autoincrement())
  idDemande Int     @map("id_demande") // no confirmed target — see module note above
  idArticle Int     @map("id_article")
  article   Article @relation(fields: [idArticle], references: [id])
  qt        Decimal

  @@map("ds_mp")
}

/// A "new/custom" fabrication request against a base article — its own
/// request entity, not a catalog. See module note above for how this
/// corrects an earlier assumption in the Sous-Traitance module.
model DsNvArticle {
  id          Int                    @id @default(autoincrement())
  idDemande   Int                    @map("id_demande") // no confirmed target — see module note above
  idArticle   Int                    @map("id_article")
  article     Article                @relation(fields: [idArticle], references: [id])
  quantite    Int
  idActivite  Int                    @map("id_activite")
  activite    ActiviteSousTraitance  @relation(fields: [idActivite], references: [id])
  description String?

  @@map("ds_nv_article")
}

// ============================================================================
// Magasin Sous-Traitance (Phase 21)
//
// Discovered while investigating quote edit/history — confirmed real via
// historique_devis_st.cs, which joins ds_devis_article.id_t to this table
// (one resolution path for the id_t/source polymorphism, alongside
// DsNvArticle already built). Tracks a physical item/tool sent to a
// subcontractor through its lifecycle: which demande it's currently out
// on, what activity is being performed, its current location, its
// current equipment association, and a repair-cycle counter.
// ============================================================================

model MagasinSousTraitance {
  id                Int                    @id @default(autoincrement())
  idArticle         Int                    @map("id_article")
  article           Article                @relation(fields: [idArticle], references: [id])
  refInterne        String                 @map("ref_interne")
  reception         Boolean                @default(false) // has this item been received back? (confirmed int in source, boolean-like)
  nbrReparation     Int                    @default(0) @map("nbr_reparation")
  demandeActuel     Int?                   @map("demande_actuel")
  demande           DemandeSousTraitance?  @relation(fields: [demandeActuel], references: [id])
  activiteActuel    Int?                   @map("activite_actuel")
  activite          ActiviteSousTraitance? @relation(fields: [activiteActuel], references: [id])
  description       String?
  emplacementActuel String?                @map("emplacement_actuel")
  equipementActuel  Int?                   @map("equipement_actuel")
  equipement        Equipement?            @relation(fields: [equipementActuel], references: [id])

  @@map("magasin_sous_traitance")
}

// ============================================================================
// Signature (Phase 22) — electronic sign-off PIN for subcontracting order
// approval
//
// Confirmed via signature_commande_attente_st.cs. `designation` is NOT a
// display name — it's a hashed PIN: the user types a code, the legacy app
// runs it through `chiffrage_signature(...)` (an unconfirmed, presumably
// custom hash), and compares against this stored value before allowing
// them to sign an order. This web version uses bcrypt instead (already
// the password-hashing choice elsewhere in this schema) rather than
// attempting to replicate an unconfirmed legacy hash algorithm — a
// deliberate modernization, not a compatibility claim.
// ============================================================================

model Signature {
  id            Int         @id @default(autoincrement())
  idUtilisateur Int         @unique @map("id_utilisateur") // real table has no unique constraint (matches the zero-constraints pattern everywhere else in this DB) — enforcing one-per-user here is a deliberate, sensible modernization, not a compatibility claim
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id])
  designation   String      // bcrypt hash of the user's signing PIN

  @@map("signature")
}

// ============================================================================
// Supplier reference-data / profile (Phase 22)
//
// Discovered via the real schema export. Fournisseur previously had no
// structured profile beyond its own flat fields (Aperçu/Adresse/Banque
// tabs) — the separate multi-contact list was already flagged as
// unbuilt in the Procurement spec, and these 6 tables turn out to cover
// adjacent ground: business activity classification, an internal
// account/spend-estimate line, currency, delivery terms, payment terms,
// and file attachments, each as a fournisseur <-> shared-reference-data
// link (5 of the 6 go through a parametre_* lookup table; file
// attachments are direct, matching the Fichier pattern used everywhere
// else in this schema).
