DATABASE_URL="postgresql://user:password@localhost:5432/gmao_web"

# Used to sign session cookies (HMAC-SHA256). Generate a real random value
# for any non-local deployment, e.g.: openssl rand -base64 32
# Falls back to an insecure default if unset — fine for local demo only.
SESSION_SECRET="change-me-to-a-random-secret"

