# Copy this file to .env.migration and fill in your real SQL Server
# connection details. This file is gitignored — never commit real
# credentials.

LEGACY_DB_SERVER=localhost
LEGACY_DB_NAME=GMAO_NGES
LEGACY_DB_USER=sa
LEGACY_DB_PASSWORD=Migration123!
LEGACY_DB_PORT=1433
LEGACY_DB_ENCRYPT=false
# Set to "false" if your SQL Server instance doesn't use an encrypted
# connection (most on-prem installs like the one this app was
# reverse-engineered from use a self-signed cert — trustServerCertificate
# is already handled for you in migration/db.ts).

